# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env. Placeholders only in this file.
# ---------------------------------------------------------------------------

# Postgres (Neon). Pooled endpoint for the application.
DATABASE_URL=
# Direct (non-pooled) endpoint. Required for migrations and advisory locking.
DIRECT_DATABASE_URL=

# Auth
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Runtime
NODE_ENV=development
API_PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Map / routing provider: google | osrm | haversine (dev fallback)
MAP_PROVIDER=google
MAP_API_KEY=
OSRM_BASE_URL=

# Payments: provider adapters are resolved per payment method.
PAYMENT_PROVIDER=cash
PAYMENT_API_KEY=

# Optional infrastructure
REDIS_URL=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
