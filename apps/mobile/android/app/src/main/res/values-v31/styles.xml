<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 31+: use the Android Splash Screen API explicitly instead of
         letting the OS derive a splash icon from the launcher icon, which
         crops more tightly and clipped the wordmark. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">#007F86</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
